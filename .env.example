# ==============================================================================
# B2B AI Workflow Automation SaaS - Environment Configuration Template
# Copy this file to '.env' and update the values with your environment secrets.
# NEVER commit the actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Database Storage
# Local SQLite database file path (relative or absolute).
# For production single-node instances, ensure this path points to a persistent volume.
DATABASE_PATH=./data/saas.db

# Stripe Webhook Secret
# Required for verifying webhook signatures sent by Stripe during checkout & subscription lifecycle.
# In local development/test, this falls back to a development secret. In production, use your live Stripe webhook secret (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# AI & LLM Provider Keys (Optional)
# If provided, live AI document extraction, classification, and synthesis can be invoked.
# When omitted, the platform defaults to high-throughput, non-blocking heuristic processors.
GEMINI_API_KEY=your_gemini_api_key_here
